{
  "name": "fastyfy-with-workers",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "dev:worker": "ts-node src/workers/runWorkers.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/runWorkers.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:worker\"",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "start:prod:worker": "NODE_ENV=production node dist/workers/runWorkers.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zajac-software-ltd/fastyfy-with-workers.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zajac-software-ltd/fastyfy-with-workers/issues"
  },
  "homepage": "https://github.com/zajac-software-ltd/fastyfy-with-workers#readme",
  "description": "",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "bullmq": "^5.65.0",
    "env-schema": "^6.0.0",
    "fastify": "^5.6.2",
    "fluent-json-schema": "^5.0.0",
    "ioredis": "^5.8.2",
    "pino-pretty": "^13.1.2",
    "pm2": "^6.0.14"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.6.1",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
